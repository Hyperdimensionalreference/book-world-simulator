[
  {
    "id": "s_open",
    "title": "开场",
    "turn": 0,
    "place": "home",
    "npcs": [
      "player",
      "mu_qin",
      "di_di"
    ],
    "trigger": {
      "type": "turn"
    },
    "mandatory": true,
    "tags": [
      "开局"
    ],
    "narration": "1987 年，北方国营纺织厂筒子楼。楼道共用水池，谁家吵架全楼都听得见。厂里要分房，名单没下来之前，所有人都在算。\n\n厂技术员，工龄中等。父亲走得早，母亲腿疾，弟弟订婚等着房。你不是劳模，也不是刺头——你身上那些没人写过的空白，才是你能落笔的地方。\n\n书上写定的事会按期来。你能改的是处境、关系、代价，以及你成为谁。",
    "choices": [
      {
        "id": "c_open_focus",
        "text": "先顾眼前最急的一头。",
        "effects": {
          "stats": {
            "guts": 3
          },
          "add_memory": [
            "你选择先顾眼前"
          ],
          "add_note": "你从具体难处下手"
        },
        "hooks": []
      },
      {
        "id": "c_open_listen",
        "text": "先听风声，弄清谁想要什么。",
        "effects": {
          "stats": {
            "craft": 3,
            "warmth": 2
          },
          "add_memory": [
            "你先听了风声"
          ],
          "add_note": "你把耳朵竖起来了"
        },
        "hooks": [
          {
            "delay": 2,
            "type": "message",
            "text": "你比别人早半步知道门道。",
            "stats": {
              "craft": 2
            }
          }
        ]
      },
      {
        "id": "c_open_hard",
        "text": "把最难看的事先扛起来。",
        "effects": {
          "stats": {
            "guts": 5,
            "health": -3,
            "favor_in": 1
          },
          "add_memory": [
            "你先扛了难看的事"
          ],
          "add_note": "你把担子放上了肩"
        },
        "hooks": []
      }
    ]
  },
  {
    "id": "s_conf_housing_list",
    "title": "分房名单",
    "turn": 1,
    "place": "hub",
    "npcs": [
      "player",
      "mu_qin"
    ],
    "trigger": {
      "type": "window",
      "start": 1,
      "end": 3
    },
    "tags": [
      "冲突",
      "housing"
    ],
    "narration": "压力点：分房名单\n\n厂里只腾出两套房。工龄、婚姻、贡献、关系都折算成分数，又都不完全是分数。\n\n赌注是：住得开住不开，以及在楼道里说话的音量。\n\n林卫东在旁边，开口是：「分到房、护住弟弟的亲事、不被厂里甩掉」\n两头都想要，或者两头都不想失去。",
    "choices": [
      {
        "id": "c_face_on",
        "text": "正面接住，把脸面和道理做足。",
        "effects": {
          "stats": {
            "face": 5,
            "guts": 3,
            "money": -15
          },
          "relationships": {
            "player": 6
          },
          "add_memory": [
            "你在「分房名单」上正面接住"
          ],
          "add_note": "你把体面买回来了"
        },
        "hooks": [
          {
            "delay": 3,
            "type": "message",
            "text": "后来在分房名单的事上，有人念你一句「做事实」。",
            "stats": {
              "face": 2
            },
            "actor": "player"
          }
        ]
      },
      {
        "id": "c_side_deal",
        "text": "私下把事办成，先顾里子。",
        "effects": {
          "stats": {
            "money": 20,
            "face": -3,
            "craft": 3
          },
          "relationships": {
            "mu_qin": 4
          },
          "add_memory": [
            "你在「分房名单」上先顾里子"
          ],
          "add_note": "你把里子保住了"
        },
        "hooks": [
          {
            "delay": 3,
            "type": "message",
            "text": "有人背后说你会打算。会打算，也是名声的一种。",
            "stats": {
              "face": -1,
              "craft": 2
            }
          }
        ]
      },
      {
        "id": "c_help_other",
        "text": "把时间让给更难的人。",
        "effects": {
          "stats": {
            "warmth": 6,
            "favor_out": 1,
            "health": -4
          },
          "relationships": {
            "player": 10
          },
          "add_memory": [
            "你在「分房名单」上让了更难的人"
          ],
          "add_note": "你把难处往后挪了半步"
        },
        "hooks": [
          {
            "delay": 4,
            "type": "message",
            "text": "那人后来记得。记得这种东西，来得慢，落得重。",
            "stats": {
              "warmth": 3
            },
            "actor": "player",
